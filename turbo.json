{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "env": ["BACKEND_URL", "X_SECRET_HEADER", "API_TIMEOUT"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "lint": {},
        "dev": {
            "persistent": true,
            "cache": false
        }
    }
}
