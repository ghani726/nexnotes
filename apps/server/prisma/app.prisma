enum Permission {
    VIEWER
    EDITOR
}

enum ShareStatus {
    PENDING
    ACCEPTED  
}

enum TaskPriority {
    LOW
    MEDIUM
    HIGH
}

// 4. COLLECTION TABLE
model Collection {
    id        String   @id @default(uuid())
    name      String

    color     Int      @default(0)
    icon      Int      @default(0)

    userID    String
    user      User     @relation("UserCollections", fields: [userID], references: [id], onDelete: Cascade)

    notes     Note[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userID, id])
}

// 5. NOTES MODEL
model Note {
    id         String       @id @default(uuid())
    title      String
    content    String?      @db.Text
    color      Int          @default(0)          // Stores a number (0, 1, 2, 3...) for note styling/themes
    isPinned   Boolean      @default(false)
    isArchived Boolean      @default(false)

    // Optimistic Concurrency Control
    version     Int      @default(1)

    // Soft Delete & 7-Day Trash Bin Fields
    isDeleted  Boolean      @default(false)
    deletedAt  DateTime?

    // Public Web Sharing Fields
    isPublic   Boolean      @default(false)
    publicId   String?      @unique

    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt

    userID     String
    user       User         @relation("NoteOwner", fields: [userID], references: [id], onDelete: Cascade)

    collectionID String?     // Optional so a note can exist without a collection
    collection   Collection? @relation(fields: [collectionID], references: [id], onDelete: SetNull)

    tasks      Task[]
    shares     SharedNote[]

    @@index([userID, id])
    @@index([collectionID])
}

// 6. TASKS MODEL
model Task {
    id          String       @id @default(uuid())
    title       String
    isCompleted Boolean      @default(false)
    dueDate     DateTime?
    priority    TaskPriority @default(MEDIUM)
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    userID      String
    noteId      String?

    user        User         @relation("TaskOwner", fields: [userID], references: [id], onDelete: Cascade)
    note        Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)

    @@index([userID, id])
    @@index([noteId])
}

// 7. SHARED NOTES MODEL (Join Table)
model SharedNote {
    id           String      @id @default(uuid())
    noteId       String
    sharedById   String
    sharedWithId String

    permission   Permission  @default(VIEWER)
    status       ShareStatus @default(PENDING)
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    note         Note        @relation(fields: [noteId], references: [id], onDelete: Cascade)
    sharedBy     User        @relation("SharesSent", fields: [sharedById], references: [id], onDelete: Cascade)
    sharedWith   User        @relation("SharesReceived", fields: [sharedWithId], references: [id], onDelete: Cascade)

    @@unique([noteId, sharedWithId]) //Note Specific

    @@index([sharedWithId, status, createdAt]) // With user
    @@index([sharedById, createdAt]) // by user
}