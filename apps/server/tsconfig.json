{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "resolveJsonModule": true,
        "sourceMap": true,
        "paths": {
            "@/*": ["./src/*"],
            "@packages/*": ["../../packages/*"]
        }
    },
    "include": ["src", "../../packages", "prisma.config.ts"]
}
