{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "rewriteRelativeImportExtensions": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}